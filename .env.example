# =============================================================================
# Ludo Nova — environment variables
# Copy to `.env` for local development. NEVER commit real secrets.
# =============================================================================

# ---- Server (apps/server) ----------------------------------------------------
# NODE_ENV is set by the platform (Render: production). Do not set it here:
# Vite would read it and ship development React builds.
PORT=4000

# PostgreSQL connection string.
#   Local (no Docker):  npm run db:local  → postgresql://ludo:ludo@localhost:5433/ludo
#   Docker compose:     postgresql://ludo:ludo@localhost:5432/ludo
#   Render:             use the "Internal Database URL" of your Render PostgreSQL
DATABASE_URL=postgresql://ludo:ludo@localhost:5433/ludo

# Optional. Enables the Socket.IO Redis adapter and the Redis matchmaking queue.
# Leave empty to use in-memory equivalents (single instance).
REDIS_URL=

# Secrets — at least 32 random characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

# Comma-separated list of browser origins allowed to call the API / socket.
CLIENT_URL=http://localhost:5173

# Optional tuning (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SAMESITE=lax          # use "none" only if the web app calls the API cross-site without the Vercel proxy
# COOKIE_DOMAIN=
# TRUST_PROXY=1
# DISCONNECT_GRACE_SECONDS=120
# LOBBY_DISCONNECT_SECONDS=60
# BOT_DELAY_MS=900
# LOG_LEVEL=info

# ---- docker compose only -----------------------------------------------------
POSTGRES_USER=ludo
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ludo
COMPOSE_CLIENT_URL=http://localhost:8080

# ---- Tests (optional) ---------------------------------------------------------
# Integration tests start an embedded PostgreSQL automatically. To use an existing
# server instead (CI does), point this at its admin database:
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ---- Web (apps/web) — public, baked into the static build -------------------
# Never put secrets in VITE_* variables: they are visible to every browser.
# API base. "/api" uses the Vite dev proxy locally and the Vercel rewrite in production.
VITE_API_URL=/api
# Socket.IO origin. Empty = same origin (dev proxy). In production: your Render URL.
VITE_SOCKET_URL=
# Public site URL used for canonical/OG tags.
VITE_SITE_URL=http://localhost:5173
# Dev proxy target for /api and /socket.io (vite dev server only).
VITE_DEV_API_TARGET=http://localhost:4000
